{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/[!_]*.js": {
      "maxDuration": 60,
      "includeFiles": "{kb,data,studio}/**"
    }
  },
  "rewrites": [
    { "source": "/agent", "destination": "/agent.html" },
    { "source": "/partners", "destination": "/partners.html" }
  ]
}
